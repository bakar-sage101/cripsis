    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@cripsis/eslint-config": "workspace:*",
    "@cripsis/typescript-config": "workspace:*",
    "eslint": "^9.15.0",
    "typescript": "^5.7.2"
  }
}
